<?xml version="1.0" encoding="UTF-8"?>
<!--
  mtls-ca の launchd 設定例（macOS）/ Example launchd job for mtls-ca (macOS)

    sudo install -m 0755 mtls-ca /usr/local/bin/
    sudo install -m 0644 io.github.nobumin.mtls-ca.plist /Library/LaunchDaemons/
    sudo launchctl bootstrap system /Library/LaunchDaemons/io.github.nobumin.mtls-ca.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.nobumin.mtls-ca</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/mtls-ca</string>
    <string>-config</string>
    <string>/usr/local/etc/mtls-ca/config.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/mtls-ca.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/mtls-ca.log</string>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
