# mtls-agent の systemd ユニット例 / Example systemd unit for mtls-agent
#
#   sudo useradd --system --home /var/lib/mtls-agent --shell /usr/sbin/nologin mtls-agent
#   sudo install -m 0755 mtls-agent /usr/local/bin/
#   sudo install -m 0644 mtls-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mtls-agent
#
# すぐに更新する / Renew now:  sudo systemctl reload mtls-agent
[Unit]
Description=mtls-agent (automatic mTLS certificate renewal)
Documentation=https://github.com/nobumin/mtls_manager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mtls-agent
# アプリに鍵を読ませる場合は、アプリと共通のグループにして key_mode を 0640 にする
# To let an app read the key, use a shared group and set output.key_mode to 0640
Group=mtls-agent
ExecStart=/usr/local/bin/mtls-agent run -config /etc/mtls-agent/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s

# http-01 / tls-alpn-01 で 80 / 443 番を一時的に開くため / To open port 80/443 during validation
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# ---- 権限の絞り込み / Hardening ----
StateDirectory=mtls-agent
StateDirectoryMode=0700
# 証明書の出力先と、webroot を使う場合はその公開ディレクトリを書き込み可能にする
# Make the output directory (and webroot, if used) writable
ReadWritePaths=/etc/mtls-agent/tls
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0022

# post_renew で systemctl reload などを実行する場合、NoNewPrivileges や権限の制限により
# 失敗することがある。その場合は polkit / sudoers で必要な操作だけを許可する。
# post_renew commands such as "systemctl reload" may need polkit/sudoers rules.

[Install]
WantedBy=multi-user.target
